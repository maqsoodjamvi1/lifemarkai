# Keep the Docker build context small + reproducible.
# NOTE: plain `node_modules` only matches the context root in Docker's matcher —
# use **/ for nested Start-app deps.
**/node_modules
**/.next
**/out
**/build
**/dist
**/.output
**/.tmp
**/.tmp-docker
**/.tanstack
**/.vite
**/coverage

# Desktop / mobile packaging (not part of the web deploy)
electron
ios
android
*.dmg
*.exe
*.AppImage

# Local env + secrets (inject via Coolify / --build-arg, never bake into the image)
.env
.env.local
.env.*.local

# VCS / editor / CI
.git
.gitignore
.github
.vscode
.idea

# Logs, caches, temp
*.log
npm-debug.log*
.cache
.turbo
*.tsbuildinfo

# Scratch / debug artifacts in the repo root
__sim.js
__sync_marker__.txt
_tmp_*.mjs
debug-*.log
build-*.txt
build-output.txt
build-result*.txt
install.log
npm-install.log
npm-search*.json
tsconfig-audit*
.tmp-docker
.tmp
kdp-workbooks
outputs
gateway/node_modules

# Docs don't need to be in the image
docs
*.md
!README.md

# Fuse / editor junk
**/.fuse_hidden*
