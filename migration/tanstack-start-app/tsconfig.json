{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // The repo's unit tests run under `node --test`, which needs the explicit
    // .ts extension on relative imports. Without this flag every test file
    // reports TS5097 for doing the only thing that works — six errors that say
    // nothing, in the noise where a real one could hide. Safe here: the flag
    // only requires noEmit, which is already set (tsc type-checks; vite builds).
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "strict": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*",
        "../../*"
      ],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}