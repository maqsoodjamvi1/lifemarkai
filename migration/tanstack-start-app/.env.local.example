# TanStack Start — sole runtime (copy to .env.local)
# Single process: Start serves UI + APIs. Next.js is not required.

# Supabase (same project as repo-root / historical Next app)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: service role for admin server paths
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL for OAuth redirects (this app's origin)
# Default Start port is 3001; set to your deployed origin in production.
VITE_APP_URL=http://localhost:3001

# Optional: Modal/E2B sandbox secrets (copy from repo-root .env.local)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# SANDBOX_PROVIDER=modal

# Worker processes (defaults shown — normally leave unset; Start spawns them
# on demand in dev, and scripts/start-production.mjs supervises them in prod)
# LIFEMARK_API_WORKER_PORT=3011      # all legacy app/api handlers
# LIFEMARK_SANDBOX_WORKER_PORT=3012  # Modal cold boot / sync
# LIFEMARK_AI_WORKER_PORT=3010       # chat/agent/fix SSE
# LIFEMARK_API_WORKER_URL=           # point at an externally supervised worker
# LIFEMARK_SANDBOX_WORKER_URL=
# LIFEMARK_AI_WORKER_URL=
