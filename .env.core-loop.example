# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or paste its secret values into chat.

CORE_LOOP_BASE_URL=http://localhost:3001
CORE_LOOP_EMAIL=reliability-test@example.com
CORE_LOOP_PASSWORD=replace-with-dedicated-test-account-password
CORE_LOOP_DEPLOY_PROVIDER=netlify
CORE_LOOP_DEPLOY_TIMEOUT_MS=180000
CORE_LOOP_GENERATION_TIMEOUT_MS=300000
CORE_LOOP_STOP_AFTER_IDENTICAL_FAILURES=3
# Campaign runners default to gpt-5.6-luna when unset so a Codespace
# OPENROUTER_CODING_MODEL=qwen override cannot stall the release gate.
CORE_LOOP_AI_MODEL=openai/gpt-5.6-luna
CORE_LOOP_FALLBACK_MODEL=deepseek/deepseek-v4-flash
CORE_LOOP_MAX_REPAIR_ROUNDS=2
CORE_LOOP_REQUIRE_REGISTRATION_PROOF=true

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Model provider (configure at least one supported provider).
OPENROUTER_API_KEY=replace-with-openrouter-key

# Production remote preview.
MODAL_TOKEN_ID=replace-with-modal-token-id
MODAL_TOKEN_SECRET=replace-with-modal-token-secret

# Default production deployment provider.
NETLIFY_AUTH_TOKEN=replace-with-netlify-token
