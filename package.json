{
  "name": "lifemarkai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "dev:3001": "vite dev --port 3001",
    "dev:warm": "node scripts/dev-with-warm.mjs",
    "build:ai-http": "node scripts/build-ai-http.mjs",
    "dev:ai-worker": "node --max-old-space-size=4096 scripts/ai-http-worker.mjs",
    "prebuild": "node scripts/build-ai-http.mjs",
    "build": "vite build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:infrastructure-contracts": "node --import tsx --test src/lib/infrastructure/private-behavioral-contracts.test.ts",
    "verify:smoke": "node scripts/verify-production-smoke.mjs",
    "verify:deploy-safety": "node scripts/verify-deploy-smoke.mjs",
    "verify:core-loop": "node --import tsx scripts/verify-core-loop-campaign.ts",
    "organize-imports": "node scripts/organize-imports.mjs",
    "remove-ts-nocheck": "node scripts/remove-ts-nocheck.mjs",
    "generate:database-types": "node scripts/generate-database-types.mjs",
    "sandbox:base-pkg": "node scripts/gen-sandbox-base-package.mjs",
    "electron:dev": "NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:3001 && electron electron/main.js\"",
    "electron:build": "npm run build && electron-builder --config electron/electron-builder.yml",
    "electron:build:mac": "npm run build && electron-builder --mac --config electron/electron-builder.yml",
    "electron:build:win": "npm run build && electron-builder --win --config electron/electron-builder.yml",
    "electron:build:linux": "npm run build && electron-builder --linux --config electron/electron-builder.yml",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "verify:core-loop:one-flow": "node scripts/verify-core-loop-one-flow.mjs",
    "verify:core-loop:smoke": "node scripts/verify-core-loop-one-flow.mjs --smoke",
    "verify:core-loop:release": "node scripts/verify-core-loop-release.mjs",
    "verify:private-infrastructure:preflight": "node scripts/verify-private-infrastructure.mjs --strict",
    "verify:private-infrastructure": "node scripts/verify-private-infrastructure.mjs --strict --live",
    "backup:database": "node scripts/backup-database.mjs",
    "recovery:drill": "node scripts/recovery-drill.mjs",
    "verify:preview-smoke": "node --experimental-strip-types scripts/smoke-preview-50.mjs",
    "verify:polyglot": "node scripts/verify-polyglot-codespace.mjs",
    "verify:gap-closure": "node --import tsx --test src/lib/editor/*.test.ts src/lib/intelligence/polyglot-bridge.test.ts && node --experimental-strip-types scripts/smoke-preview-50.mjs"
  }
}
