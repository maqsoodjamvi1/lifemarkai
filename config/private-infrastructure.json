{
  "version": 1,
  "capabilities": [
    {
      "id": "ai_gateway",
      "label": "AI model gateway and routing",
      "paths": [
        "src/lib/ai/provider.ts",
        "src/lib/ai/gateway-client.ts"
      ],
      "anyEnv": [
        [
          "OPENROUTER_API_KEY"
        ],
        [
          "OPENAI_API_KEY"
        ],
        [
          "ANTHROPIC_API_KEY"
        ]
      ]
    },
    {
      "id": "agents",
      "label": "Prompt planning and code-generation agents",
      "paths": [
        "src/lib/ai/http/agent.ts",
        "src/lib/ai/http/chat.ts"
      ]
    },
    {
      "id": "generation_contract",
      "label": "Structured file-generation contract",
      "paths": [
        "src/lib/ai/code-parser.ts",
        "src/lib/ai/streaming-file-extractor.ts"
      ]
    },
    {
      "id": "automatic_repair",
      "label": "Automatic build diagnosis and repair",
      "paths": [
        "src/lib/ai/self-verify.ts",
        "src/lib/ai/prompts/auto-fix.ts"
      ]
    },
    {
      "id": "sandbox",
      "label": "Isolated sandbox lifecycle",
      "paths": [
        "src/lib/sandbox/index.ts",
        "src/lib/sandbox/modal.ts"
      ],
      "anyEnv": [
        [
          "MODAL_TOKEN_ID",
          "MODAL_TOKEN_SECRET"
        ],
        [
          "SANDBOX_BASE_URL"
        ]
      ]
    },
    {
      "id": "remote_preview",
      "label": "Remote Vite preview URLs",
      "paths": [
        "src/lib/preview/serve-preview.ts",
        "src/routes/api/projects/$id/sandbox-preview.ts"
      ]
    },
    {
      "id": "dependency_cache",
      "label": "Dependency installation and caching",
      "paths": [
        "docker/sandbox/Dockerfile",
        "src/lib/sandbox/modal.ts"
      ]
    },
    {
      "id": "repositories",
      "label": "Project repositories and revisions",
      "paths": [
        "src/lib/server-fns/snapshots.ts",
        "src/lib/server-fns/restore-project-files.ts"
      ]
    },
    {
      "id": "queues",
      "label": "Background queues and workers",
      "paths": [
        "src/lib/queue/client.ts",
        "scripts/ai-http-worker.mjs"
      ],
      "anyEnv": [
        [
          "REDIS_URL"
        ],
        [
          "UPSTASH_REDIS_REST_URL",
          "UPSTASH_REDIS_REST_TOKEN"
        ]
      ]
    },
    {
      "id": "cloud_database",
      "label": "Supabase/PostgreSQL provisioning",
      "paths": [
        "src/routes/api/cloud/provision.ts",
        "supabase/config.toml"
      ],
      "anyEnv": [
        [
          "VITE_SUPABASE_URL",
          "SUPABASE_SERVICE_ROLE_KEY"
        ],
        [
          "NEXT_PUBLIC_SUPABASE_URL",
          "SUPABASE_SERVICE_ROLE_KEY"
        ]
      ]
    },
    {
      "id": "secrets_connectors",
      "label": "Secrets and connector management",
      "paths": [
        "src/routes/api/projects/$id/env-health.ts",
        "src/components/editor/connector-wizard-panel.tsx"
      ]
    },
    {
      "id": "deployment",
      "label": "Production deployment pipeline",
      "paths": [
        "src/routes/api/deploy.ts",
        "src/lib/deploy/publish-from-chat.ts"
      ],
      "anyEnv": [
        [
          "NETLIFY_AUTH_TOKEN"
        ],
        [
          "VERCEL_TOKEN"
        ],
        [
          "COOLIFY_API_TOKEN"
        ]
      ]
    },
    {
      "id": "billing",
      "label": "Credits, billing and cost accounting",
      "paths": [
        "src/routes/api/billing/webhook.ts",
        "src/lib/credits/index.ts"
      ],
      "anyEnv": [
        [
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET"
        ]
      ]
    },
    {
      "id": "rate_limiting",
      "label": "Rate limiting and abuse prevention",
      "paths": [
        "src/lib/rate-limit.ts",
        "src/lib/security/detect-secret.ts"
      ]
    },
    {
      "id": "observability",
      "label": "Logs, metrics and tracing",
      "paths": [
        "src/lib/logger.ts",
        "src/lib/ai/generation-observability.ts"
      ],
      "anyEnv": [
        [
          "SENTRY_DSN"
        ],
        [
          "OTEL_EXPORTER_OTLP_ENDPOINT"
        ]
      ]
    },
    {
      "id": "enterprise",
      "label": "Team permissions and enterprise controls",
      "paths": [
        "src/routes/api/teams/$id/members.ts",
        "src/routes/api/enterprise/sso.ts"
      ]
    },
    {
      "id": "security",
      "label": "Security scanning",
      "paths": [
        "src/lib/security/static-scan.ts",
        "src/routes/api/projects/$id/security-scan.ts"
      ]
    },
    {
      "id": "backup_recovery",
      "label": "Backup and disaster recovery",
      "paths": [
        "src/lib/server-fns/snapshots.ts",
        "docs/BACKUP_AND_RECOVERY.md"
      ],
      "anyEnv": [
        [
          "DATABASE_URL"
        ]
      ]
    }
  ]
}
